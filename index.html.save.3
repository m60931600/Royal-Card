    </div>
</div>

<script>
let currentUser = null;
let balance = 0;
let categories = [];
let products = [];
let orders = [];
let paymentMethods = [];

function loadData() {
    try {
        balance = parseInt(localStorage.getItem('balance')) || 0;
        categories = JSON.parse(localStorage.getItem('categories')) || [
            { id: 1, name: '🎮 ألعاب', icon: '🎮' },
            { id: 2, name: '📱 تطبيقات', icon: '📱' },
            { id: 3, name: '🎬 اشتراكات', icon: '🎬' }
        ];
        products = JSON.parse(localStorage.getItem('products')) || [
            { id: 1, categoryId: 1, name: 'لعبة الأسطورة', price: 25, icon: '⚔️' },
            { id: 2, categoryId: 2, name: 'تطبيق VIP', price: 15, icon: '⭐' },
            { id: 3, categoryId: 3, name: 'نتفلكس شهر', price: 30, icon: '🎥' }
        ];
        orders = JSON.parse(localStorage.getItem('orders')) || [];
        paymentMethods = JSON.parse(localStorage.getItem('paymentMethods')) || [];
        if (categories.length === 0) categories = [{ id: 1, name: '🎮 ألعاب', icon: '🎮' }];
    } catch(e) { console.log('خطأ'); }
}

function saveData() {
    localStorage.setItem('balance', balance);
    localStorage.setItem('categories', JSON.stringify(categories));
    localStorage.setItem('products', JSON.stringify(products));
    localStorage.setItem('orders', JSON.stringify(orders));
    localStorage.setItem('paymentMethods', JSON.stringify(paymentMethods));
}

function loginWith(provider) {
    currentUser = { name: 'مستخدم ' + provider, provider: provider };
    localStorage.setItem('user', JSON.stringify(currentUser));
    updateUI();
    closeModal('loginModal');
    alert('👋 مرحباً ' + currentUser.name);
}

function loginNormal() {
    const name = document.getElementById('loginUsername').value.trim();
    const pass = document.getElementById('loginPassword').value.trim();
    if (!name || !pass) return alert('❌ أدخل اسم المستخدم وكلمة السر');
    currentUser = { name: name, provider: 'normal' };
    localStorage.setItem('user', JSON.stringify(currentUser));
    updateUI();
    closeModal('loginModal');
    alert('👋 مرحباً ' + currentUser.name);
}

function registerNormal() {
    const name = document.getElementById('loginUsername').value.trim();
    const pass = document.getElementById('loginPassword').value.trim();
    if (!name || !pass) return alert('❌ أدخل اسم المستخدم وكلمة السر');
    currentUser = { name: name, provider: 'normal' };
    localStorage.setItem('user', JSON.stringify(currentUser));
    updateUI();
    closeModal('loginModal');
    alert('✅ تم إنشاء الحساب!');
}

function logout() {
    currentUser = null;
    localStorage.removeItem('user');
    updateUI();
    alert('👋 تم تسجيل الخروج');
}

function showLoginModal() {
    document.getElementById('loginModal').classList.add('show');
}

function closeModal(id) {
    document.getElementById(id).classList.remove('show');
}

function updateUI() {
    const userData = localStorage.getItem('user');
    if (userData) currentUser = JSON.parse(userData);
    
    const loginBtn = document.getElementById('loginBtnTop');
    const logoutBtn = document.getElementById('logoutBtnTop');
    const userNameDisplay = document.getElementById('userNameDisplay');
    
    if (currentUser) {
        loginBtn.style.display = 'none';
        logoutBtn.style.display = 'inline-block';
        userNameDisplay.textContent = '👋 ' + currentUser.name;
    } else {
        loginBtn.style.display = 'inline-block';
        logoutBtn.style.display = 'none';
        userNameDisplay.textContent = '';
    }
    updateBalance();
    renderCategories();
    renderProducts();
    renderOrders();
    renderPaymentMethods();
}

function updateBalance() {
    document.getElementById('headerBalance').textContent = balance;
    document.getElementById('balancePageAmount').textContent = balance;
}

function showPage(page) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    const target = document.getElementById('page-' + page);
    if (target) target.classList.add('active');
}

function showAddBalanceModal() {
    if (!currentUser) return alert('🔒 يرجى تسجيل الدخول أولاً');
    document.getElementById('balanceModal').classList.add('show');
}

function addBalance() {
    const amount = parseInt(document.getElementById('addBalanceAmount').value);
    if (!amount || amount < 1) return alert('❌ أدخل مبلغاً صحيحاً');
    balance += amount;
    saveData();
    updateBalance();
    closeModal('balanceModal');
    document.getElementById('addBalanceAmount').value = '';
    alert('✅ تم إضافة ' + amount + ' ريال');
}

function renderCategories() {
    const container = document.getElementById('categoriesContainer');
    if (!container) return;
    container.innerHTML = '';
    categories.forEach(cat => {
        const catProducts = products.filter(p => p.categoryId === cat.id);
        const div = document.createElement('div');
        div.className = 'category-card';
        div.innerHTML = `
            <div class="category-image">${cat.icon}</div>
            <div class="category-info">
                <h3>${cat.name}</h3>
                <p>${catProducts.length} منتج</p>
                <div class="products-grid">
                    ${catProducts.map(p => `
                        <div class="product-card" onclick="buyProduct(${p.id})">
                            <div class="product-image">${p.icon}</div>
                            <div class="product-info">
                                <h4>${p.name}</h4>
                                <div class="price">${p.price} ريال</div>
                            </div>
                        </div>
                    `).join('')}
                </div>
            </div>
        `;
        container.appendChild(div);
    });
    
    const categoryList = document.getElementById('categoryList');
    if (categoryList) {
        categoryList.innerHTML = categories.map(cat => `
            <div class="admin-product-item">
                <span>${cat.icon} ${cat.name}</span>
                <button class="btn btn-danger" onclick="deleteCategory(${cat.id})">🗑️ حذف</button>
            </div>
        `).join('');
    }
    updateSelects();
}

function addCategory() {
    if (!currentUser) return alert('🔒 يرجى تسجيل الدخول');
    const name = document.getElementById('newCategoryName').value.trim();
    const icon = document.getElementById('newCategoryIcon').value.trim() || '📁';
    if (!name) return alert('❌ أدخل اسم القسم');
    const id = categories.length > 0 ? Math.max(...categories.map(c => c.id)) + 1 : 1;
    categories.push({ id, name, icon });
    saveData();
    renderCategories();
    document.getElementById('newCategoryName').value = '';
    document.getElementById('newCategoryIcon').value = '';
}

function deleteCategory(id) {
    if (!confirm('هل أنت متأكد من حذف هذا القسم؟')) return;
    categories = categories.filter(c => c.id !== id);
    products = products.filter(p => p.categoryId !== id);
    saveData();
    renderCategories();
}

function renderProducts() {
    const productList = document.getElementById('productList');
    if (!productList) return;
    productList.innerHTML = products.map(p => {
        const cat = categories.find(c => c.id === p.categoryId);
        return `
            <div class="admin-product-item">
                <span>${p.icon} ${p.name} - ${p.price} ريال ${cat ? '(في ' + cat.name + ')' : ''}</span>
                <button class="btn btn-danger" onclick="deleteProduct(${p.id})">🗑️ حذف</button>
            </div>
        `;
    }).join('');
}

function addProduct() {
    if (!currentUser) return alert('🔒 يرجى تسجيل الدخول');
    const categoryId = parseInt(document.getElementById('productCategorySelect').value);
    const name = document.getElementById('newProductName').value.trim();
    const price = parseFloat(document.getElementById('newProductPrice').value);
    const icon = document.getElementById('newProductIcon').value.trim() || '🎁';
    if (!name || !price) return alert('❌ أدخل اسم المنتج والسعر');
    const id = products.length > 0 ? Math.max(...products.map(p => p.id)) + 1 : 1;
    products.push({ id, categoryId, name, price, icon });
    saveData();
    renderCategories();
    renderProducts();
    document.getElementById('newProductName').value = '';
    document.getElementById('newProductPrice').value = '';
    document.getElementById('newProductIcon').value = '';
}

function deleteProduct(id) {
    if (!confirm('هل أنت متأكد من حذف هذا المنتج؟')) return;
    products = products.filter(p => p.id !== id);
    saveData();
    renderCategories();
    renderProducts();
}

function updateSelects() {
    const select = document.getElementById('productCategorySelect');
    if (select) {
        select.innerHTML = categories.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
    }
}

function renderOrders() {
    const el = document.getElementById('ordersList');
    if (!el) return;
    el.innerHTML = orders.map(o => `
        <div class="admin-order-item">
            <div>🛍️ ${o.productName}</div>
            <div>💰 ${o.price} ريال</div>
            <div>📅 ${o.date}</div>
        </div>
    `).join('') || '<p style="text-align:center;color:var(--text-dim);">لا توجد طلبات</p>';
}

function renderPaymentMethods() {
    const el = document.getElementById('paymentMethodsGrid');
    if (!el) return;
    el.innerHTML = paymentMethods.map(m => `
        <div class="payment-card">
            <div class="payment-image"><i class="fas fa-credit-card"></i></div>
            <h4>${m.name}</h4>
            <div class="payment-info">الرقم: ${m.number}</div>
        </div>
    `).join('') || '<p style="text-align:center;color:var(--text-dim);">لا توجد طرق دفع</p>';
}

function buyProduct(id) {
    if (!currentUser) {
        showLoginModal();
        return;
    }
    const product = products.find(p => p.id === id);
    if (!product) return;
    if (balance < product.price) {
        alert('❌ رصيدك غير كافٍ!');
        return;
    }
    if (!confirm('هل تريد شراء ' + product.name + ' بسعر ' + product.price + ' ريال؟')) return;
    balance -= product.price;
    orders.push({
        id: Date.now(),
        productId: product.id,
        productName: product.name,
        price: product.price,
        date: new Date().toLocaleDateString('ar')
    });
    saveData();
    updateBalance();
    renderOrders();
    alert('✅ تم الشراء بنجاح!');
}

window.onload = function() {
    loadData();
    updateUI();
};
</script>
</body>
</html>
