            font-size: 60px;
            color: var(--primary);
            overflow: hidden;
        }

        .category-card .category-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .category-card .category-info {
            padding: 15px 20px;
        }

        .category-card .category-info h3 {
            font-size: 20px;
            color: var(--primary);
        }

        .category-card .category-info p {
            color: var(--text-dim);
            font-size: 14px;
            margin-top: 5px;
        }

        /* ===== الأقسام الفرعية ===== */
        .sub-category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .sub-category-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 15px;
            text-align: center;
            transition: 0.3s;
            cursor: pointer;
        }

        .sub-category-card:hover {
            border-color: var(--primary);
            transform: translateY(-3px);
        }

        .sub-category-card .sub-image {
            width: 100%;
            height: 100px;
