    <style>
        /* ===== الألوان الأساسية (قابلة للتغيير) ===== */
        :root {
            --primary: #ffd700;
            --primary-dark: #c9a800;
            --bg: #0a0a1a;
            --bg-card: rgba(255, 255, 255, 0.05);
            --text: #ffffff;
            --text-dim: #aaaaaa;
            --border: rgba(255, 215, 0, 0.2);
            --radius: 20px;
            --shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            --success: #4caf50;
            --danger: #ff4444;
            --danger-bg: rgba(255, 68, 68, 0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', 'Tajawal', sans-serif;
        }

        body {
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            padding-bottom: 80px;
            overflow-x: hidden;
        }

        /* ===== شريط الرصيد العلوي ===== */
        .top-bar {
            background: rgba(10, 10, 26, 0.95);
            padding: 12px 0;
            border-bottom: 2px solid var(--primary);
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(10px);
            text-align: center;
        }

        .top-bar .balance {
            font-size: 18px;
            color: var(--primary);
        }

        .top-bar .balance span {
            font-weight: bold;
            font-size: 22px;
        }

        .top-bar .balance .btn-add {
            background: var(--primary);
            color: #000;
            border: none;
            border-radius: 30px;
            padding: 5px 15px;
            font-size: 12px;
            font-weight: bold;
            cursor: pointer;
            margin-right: 10px;
            transition: 0.3s;
        }

        .top-bar .balance .btn-add:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.3);
        }

        /* ===== التنقل السفلي ===== */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(10, 10, 26, 0.98);
            border-top: 2px solid var(--primary);
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 8px 0;
            z-index: 999;
            backdrop-filter: blur(10px);
        }

        .bottom-nav a {
            color: var(--text-dim);
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 12px;
            transition: 0.3s;
            cursor: pointer;
            border: none;
            background: transparent;
            flex: 1;
        }

        .bottom-nav a i {
            font-size: 22px;
            margin-bottom: 2px;
        }

        .bottom-nav a:hover,
        .bottom-nav a.active {
            color: var(--primary);
        }

        .bottom-nav a.active {
            color: var(--primary);
            background: rgba(255, 215, 0, 0.1);
        }

        /* ===== الأزرار ===== */
        .btn {
            padding: 10px 22px;
            border: none;
            border-radius: 30px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: var(--primary);
            color: #000;
        }

        .btn-primary:hover {
            transform: scale(1.05);
            box-shadow: 0 0 30px rgba(255, 215, 0, 0.3);
        }

        .btn-secondary {
            background: transparent;
            color: #fff;
            border: 2px solid var(--primary);
        }

        .btn-secondary:hover {
            background: var(--primary);
            color: #000;
        }

        .btn-danger {
            background: var(--danger);
            color: #fff;
        }

        .btn-danger:hover {
            background: #cc0000;
        }

        .btn-success {
            background: var(--success);
            color: #fff;
        }

        .btn-success:hover {
            background: #388e3c;
        }

        /* ===== الصفحات ===== */
        .page {
            display: none;
            padding: 20px 0 30px;
            animation: fadeIn 0.4s;
        }

        .page.active {
            display: block;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .section-title {
            text-align: center;
            font-size: 28px;
            color: var(--primary);
            margin-bottom: 25px;
        }

        /* ===== الرسالة الخطأ الكبيرة ===== */
        .error-message {
            background: var(--danger-bg);
            border: 3px solid var(--danger);
            border-radius: var(--radius);
            padding: 20px 25px;
            margin: 15px 0;
            text-align: center;
            animation: shake 0.5s ease-in-out;
        }

        .error-message i {
            font-size: 48px;
            color: var(--danger);
            display: block;
            margin-bottom: 10px;
        }

        .error-message h3 {
            color: var(--danger);
            font-size: 24px;
            margin-bottom: 5px;
        }

        .error-message p {
            color: var(--text);
            font-size: 16px;
        }

        @keyframes shake {
            0%,
            100% {
                transform: translateX(0);
            }
            20% {
                transform: translateX(-15px);
            }
            40% {
                transform: translateX(15px);
            }
            60% {
                transform: translateX(-10px);
            }
            80% {
                transform: translateX(10px);
            }
        }

        /* ===== بطاقات الأقسام ===== */
        .category-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
