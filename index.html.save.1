        }

        .sub-category-card .sub-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .sub-category-card h4 {
            font-size: 14px;
            margin-top: 8px;
        }

        /* ===== المنتجات ===== */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .product-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 15px;
            overflow: hidden;
            transition: 0.3s;
            cursor: pointer;
            text-align: center;
