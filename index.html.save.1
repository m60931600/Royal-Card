        }
        .status-completed {
            color: var(--success);
        }
        .status-rejected {
            color: var(--danger);
        }

        /* ===== أدوات مساعدة ===== */
        .text-gold {
            color: var(--primary);
        }
        .mt-20 {
            margin-top: 20px;
        }
        .mb-20 {
            margin-bottom: 20px;
        }
        .flex-center {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .hidden {
            display: none;
        }

        /* ===== استجابة للجوال ===== */
        @media (max-width: 768px) {
            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            }
            .sub-category-grid {
                grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            }
            .payment-grid {
                grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            }
            .admin-grid {
                grid-template-columns: 1fr;
            }
            .bottom-nav a {
                font-size: 10px;
                padding: 4px 6px;
            }
            .bottom-nav a i {
                font-size: 18px;
            }
            .modal-content {
                padding: 20px;
            }
        }
    </style>
</head>
<body>

    <!-- ===== شريط الرصيد العلوي ===== -->
    <div class="top-bar">
        <div class="container">
            <div class="balance">
                <i class="fas fa-wallet"></i>
                رصيدي: <span id="headerBalance">150</span> <span id="currencySymbol">ريال</span>
                <button class="btn-add" onclick="showPage('payment')">
                    <i class="fas fa-plus"></i> إضافة رصيد
                </button>
            </div>
        </div>
    </div>

    <!-- ===== التنقل السفلي ===== -->
    <nav class="bottom-nav">
        <a class="active" onclick="showPage('home')">
            <i class="fas fa-home"></i> الرئيسية
        </a>
        <a onclick="showPage('shop')">
            <i class="fas fa-store"></i> المتجر
        </a>
        <a onclick="showPage('balance')">
            <i class="fas fa-wallet"></i> الرصيد
        </a>
        <a onclick="showPage('payment')">
            <i class="fas fa-credit-card"></i> الدفع
        </a>
        <a onclick="showPage('converter')">
            <i class="fas fa-exchange-alt"></i> تحويل
        </a>
        <a onclick="showPage('orders')">
            <i class="fas fa-list"></i> طلباتي
        </a>
        <a onclick="showPage('admin')" style="color:var(--primary);">
            <i class="fas fa-cog"></i> إدارة
        </a>
    </nav>

    <div class="container">

        <!-- ===== الصفحة الرئيسية ===== -->
        <section id="page-home" class="page active">
            <div style="text-align:center;padding:30px 0;">
                <h1 style="font-size:36px;color:var(--primary);">🛍️ رويال كارد</h1>
                <p style="font-size:18px;color:var(--text-dim);margin:15px 0;" id="homeDescription">أفضل الخدمات الرقمية بجودة عالية</p>
                <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
                    <button class="btn btn-primary" onclick="showPage('shop')">🛍️ تسوق الآن</button>
                    <button class="btn btn-secondary" onclick="showPage('payment')">💰 إضافة رصيد</button>
                    <button class="btn btn-secondary" onclick="showPage('converter')">💱 تحويل العملات</button>
                    <button class="btn btn-secondary" onclick="showPage('admin')">🔧 إدارة</button>
                </div>
                <div style="margin-top:30px;display:flex;gap:20px;justify-content:center;flex-wrap:wrap;">
                    <div style="background:var(--bg-card);padding:15px 25px;border-radius:15px;border:1px solid var(--border);">
                        <div style="font-size:24px;color:var(--primary);">⭐</div>
                        <div style="font-weight:bold;">4.9/5</div>
                        <div style="font-size:12px;color:var(--text-dim);">تقييم العملاء</div>
                    </div>
                    <div style="background:var(--bg-card);padding:15px 25px;border-radius:15px;border:1px solid var(--border);">
                        <div style="font-size:24px;color:var(--primary);">✅</div>
                        <div style="font-weight:bold;">100%</div>
                        <div style="font-size:12px;color:var(--text-dim);">ضمان الجودة</div>
                    </div>
                    <div style="background:var(--bg-card);padding:15px 25px;border-radius:15px;border:1px solid var(--border);">
                        <div style="font-size:24px;color:var(--primary);">⚡</div>
                        <div style="font-weight:bold;">فوري</div>
                        <div style="font-size:12px;color:var(--text-dim);">توصيل الخدمة</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ===== صفحة المتجر ===== -->
        <section id="page-shop" class="page">
            <h2 class="section-title">🛍️ المتجر</h2>
            <div id="categoriesContainer"></div>
        </section>

        <!-- ===== صفحة الرصيد ===== -->
        <section id="page-balance" class="page">
            <h2 class="section-title">💰 الرصيد</h2>
            <div style="text-align:center;background:var(--bg-card);border:2px solid var(--primary);border-radius:var(--radius);padding:30px;max-width:400px;margin:auto;">
                <i class="fas fa-wallet" style="font-size:60px;color:var(--primary);"></i>
                <div style="font-size:36px;color:var(--primary);font-weight:bold;margin:15px 0;" id="balancePageAmount">150</div>
                <div style="color:var(--text-dim);">رصيدك الحالي</div>
                <button class="btn btn-primary mt-20" onclick="showPage('payment')">💰 إضافة رصيد</button>
            </div>
            <div style="margin-top:30px;">
                <h3 style="color:var(--primary);text-align:center;">طرق الدفع المتاحة</h3>
                <div class="payment-grid" id="paymentMethodsGrid"></div>
            </div>
        </section>

        <!-- ===== صفحة الدفع ===== -->
        <section id="page-payment" class="page">
            <h2 class="section-title">💳 طرق الدفع</h2>
            <div class="payment-grid" id="paymentMethodsGrid2"></div>
            <div style="text-align:center;margin-top:20px;">
                <button class="btn btn-primary" onclick="showAddBalanceModal()">💰 إضافة رصيد</button>
            </div>
        </section>

        <!-- ===== صفحة تحويل العملات ===== -->
        <section id="page-converter" class="page">
            <h2 class="section-title">💱 تحويل العملات</h2>
            <div class="converter-box">
                <h3 style="color:var(--primary);text-align:center;margin-bottom:15px;">حاسبة الصرف</h3>
                <div class="form-group">
                    <label>💵 المبلغ بالعملة الأجنبية</label>
                    <input type="number" id="convertAmount" placeholder="أدخل المبلغ" min="0.5" step="0.01" oninput="calculateConversion()">
                    <div style="font-size:12px;color:var(--text-dim);margin-top:5px;">⚠️ أقل قيمة مسموحة: 0.50 دولار (نصف دولار)</div>
                </div>
                <div class="form-group">
                    <label>🌍 اختر العملة</label>
                    <select id="convertCurrency" onchange="calculateConversion()">
                        <option value="usd">🇺🇸 دولار أمريكي (USD)</option>
                        <option value="eur">🇪🇺 يورو (EUR)</option>
                        <option value="gbp">🇬🇧 جنيه إسترليني (GBP)</option>
                        <option value="try">🇹🇷 ليرة تركية (TRY)</option>
                        <option value="jod">🇯🇴 دينار أردني (JOD)</option>
                        <option value="aed">🇦🇪 درهم إماراتي (AED)</option>
                        <option value="egp">🇪🇬 جنيه مصري (EGP)</option>
                        <option value="sar">🇸🇦 ريال سعودي (SAR)</option>
                    </select>
                </div>
                <div class="result">
                    <div style="color:var(--text-dim);">🇸🇾 يساوي بالليرة السورية</div>
                    <div class="amount" id="convertResult">0.00</div>
                    <div style="font-size:12px;color:var(--text-dim);margin-top:5px;">سعر الصرف: <span id="exchangeRateDisplay">1 دولار = 15000 ليرة</span></div>
                </div>
            </div>
            <div style="text-align:center;margin-top:20px;">
                <p style="color:var(--text-dim);font-size:14px;">⚠️ هذه الأسعار تقريبية ويتم تحديثها من قبل المشرف</p>
            </div>
        </section>

        <!-- ===== صفحة طلباتي ===== -->
        <section id="page-orders" class="page">
            <h2 class="section-title">📋 طلباتي</h2>
            <div id="ordersList"></div>
        </section>

        <!-- ===== صفحة الإدارة ===== -->
        <section id="page-admin" class="page">
            <h2 class="section-title">🔧 لوحة التحكم</h2>

            <!-- إدارة العملة وسعر الصرف -->
            <div class="admin-panel">
                <h3>💱 إدارة العملة وسعر الصرف</h3>
                <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
                    <input type="text" id="currencyInput" value="ريال" style="padding:10px;border-radius:12px;border:1px solid #333;background:#0a0a1a;color:#fff;flex:1;" placeholder="اسم العملة المحلية">
                    <button class="btn btn-primary" onclick="updateCurrency()">تحديث العملة</button>
                </div>
                <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:10px;">
                    <select id="exchangeCurrencySelect" style="padding:10px;border-radius:12px;border:1px solid #333;background:#0a0a1a;color:#fff;flex:1;">
                        <option value="usd">🇺🇸 دولار أمريكي (USD)</option>
                        <option value="eur">🇪🇺 يورو (EUR)</option>
                        <option value="gbp">🇬🇧 جنيه إسترليني (GBP)</option>
                        <option value="try">🇹🇷 ليرة تركية (TRY)</option>
                        <option value="jod">🇯🇴 دينار أردني (JOD)</option>
                        <option value="aed">🇦🇪 درهم إماراتي (AED)</option>
                        <option value="egp">🇪🇬 جنيه مصري (EGP)</option>
                        <option value="sar">🇸🇦 ريال سعودي (SAR)</option>
                    </select>
                    <input type="number" id="exchangeRateInput" placeholder="سعر الصرف" style="padding:10px;border-radius:12px;border:1px solid #333;background:#0a0a1a;color:#fff;flex:1;">
                    <button class="btn btn-primary" onclick="updateExchangeRate()">تحديث السعر</button>
                </div>
            </div>

            <!-- إدارة الأقسام الرئيسية -->
            <div class="admin-panel">
                <h3>📂 إدارة الأقسام الرئيسية</h3>
                <div class="admin-grid">
                    <div class="admin-card">
                        <h4>➕ إضافة قسم رئيسي</h4>
                        <input type="text" id="newCategoryName" placeholder="اسم القسم">
                        <input type="file" id="newCategoryImage" accept="image/*">
                        <button class="btn btn-primary" onclick="addCategory()">إضافة</button>
                    </div>
                    <div class="admin-card">
                        <h4>🗑️ حذف قسم رئيسي</h4>
                        <select id="deleteCategorySelect"></select>
                        <button class="btn btn-danger" onclick="deleteCategory()">حذف</button>
                    </div>
                </div>
            </div>

            <!-- إدارة الأقسام الفرعية -->
            <div class="admin-panel">
                <h3>📂 إدارة الأقسام الفرعية</h3>
                <div class="admin-grid">
                    <div class="admin-card">
                        <h4>➕ إضافة قسم فرعي</h4>
                        <select id="subCategoryParentSelect"></select>
                        <input type="text" id="newSubCategoryName" placeholder="اسم القسم الفرعي">
                        <input type="file" id="newSubCategoryImage" accept="image/*">
                        <button class="btn btn-primary" onclick="addSubCategory()">إضافة</button>
                    </div>
                    <div class="admin-card">
                        <h4>🗑️ حذف قسم فرعي</h4>
                        <select id="deleteSubCategorySelect"></select>
                        <button class="btn btn-danger" onclick="deleteSubCategory()">حذف</button>
                    </div>
                </div>
            </div>

            <!-- إدارة المنتجات -->
            <div class="admin-panel">
                <h3>📦 إدارة المنتجات</h3>
                <div class="admin-grid">
                    <div class="admin-card">
                        <h4>➕ إضافة منتج</h4>
                        <select id="productCategorySelect"></select>
                        <input type="text" id="newProductName" placeholder="اسم المنتج">
                        <input type="number" id="newProductPrice" placeholder="السعر">
                        <input type="number" id="newProductMaxQty" placeholder="الحد الأقصى للشراء" value="5">
                        <input type="text" id="newProductDesc" placeholder="الوصف">
                        <input type="file" id="newProductImage" accept="image/*">
                        <button class="btn btn-primary" onclick="addProduct()">إضافة</button>
                    </div>
                    <div class="admin-card">
                        <h4>🗑️ حذف منتج</h4>
                        <select id="deleteProductCategorySelect"></select>
                        <select id="deleteProductSelect"></select>
                        <button class="btn btn-danger" onclick="deleteProduct()">حذف</button>
                    </div>
                </div>
            </div>

            <!-- إدارة طرق الدفع -->
            <div class="admin-panel">
                <h3>💳 إدارة طرق الدفع</h3>
                <div class="admin-grid">
                    <div class="admin-card">
                        <h4>➕ إضافة طريقة دفع</h4>
                        <input type="text" id="newPayName" placeholder="الاسم">
                        <input type="text" id="newPayNumber" placeholder="الرقم">
                        <input type="text" id="newPayCode" placeholder="رمز الكود">
                        <input type="file" id="newPayImage" accept="image/*">
                        <button class="btn btn-primary" onclick="addPaymentMethod()">إضافة</button>
                    </div>
                    <div class="admin-card">
                        <h4>🗑️ حذف طريقة دفع</h4>
                        <select id="deletePaymentSelect"></select>
                        <button class="btn btn-danger" onclick="deletePaymentMethod()">حذف</button>
                    </div>
                </div>
            </div>

            <!-- إدارة الطلبات -->
            <div class="admin-panel">
                <h3>📋
