            max-height: 90vh;
            overflow-y: auto;
            position: relative;
        }

        .modal-content .close {
            position: absolute;
            top: 10px;
            left: 18px;
            font-size: 28px;
            color: #fff;
            cursor: pointer;
        }

        .modal-content .close:hover {
            color: var(--primary);
        }

        .modal-content h2 {
            color: var(--primary);
            margin-bottom: 15px;
            text-align: center;
        }

